%% =========================================================================
%  PLOT_OHIO_RECONSTRUCCION_COOPT.M
%  Figuras de reconstruccion en OhioT1DM con las dos configuraciones
%  co-optimas (GRU->GRU y GRU->1D-CNN) sobre los mismos episodios.
%  =========================================================================
%  No corre redes ni modifica resultados: lee los .mat que guarda
%  main_pipeline_ohio_v3/v4 (corrida final, etiqueta '_synth_s5p6_exc') y
%  dibuja, con el mismo estilo que la figura de reconstruccion de la
%  Seccion 4.4 (referencia negra, lectura con fallo gris punteada, GRU->GRU
%  naranja, GRU->1D-CNN morado discontinuo):
%
%    Figura 1  Ventana completa de 5 dias de cada paciente (3 paneles).
%    Figura 2  Acercamientos a los episodios inyectados mas largos de cada
%              tipo, en 2 filas x 3 columnas (una columna por paciente):
%              fila 1, desconexion de 50 muestras; fila 2, rafaga de ruido de
%              35 muestras.
%    Figura 3  (opcional, desactivada) Acercamiento a los huecos reales largos:
%              no hay referencia, asi que solo se ve la salida de cada
%              configuracion.
%
%  Criterios de dibujo:
%    - La salida de cada configuracion es la media de sus 5 redes y solo se
%      dibuja donde difiere de la lectura (segmentos imputados, incluidas las
%      falsas alarmas), con una muestra de margen para que las lineas conecten.
%    - Las lecturas en cero (desconexion o hueco) se enmascaran; el episodio
%      se ve con el sombreado: desconexion (rosa), ruido (amarillo) y hueco
%      real (gris).
%    - Sin titulos ni nombres de paciente dentro de los paneles: cada panel
%      lleva debajo del eje X su letra en negritas, (a), (b), ..., y el pie de
%      figura (en el .tex) explica a que paciente y episodio corresponde cada
%      una. La etiqueta de tiempo aparece solo en la fila inferior de cada
%      figura. Excepcion: la Figura 2 lleva el paciente como titulo de cada
%      columna (show_col_titles).
%    - Cada figura muestra en la leyenda solo lo que aparece en ella.
%
%  Salidas (figures/ohio): fig_ohio_reconstruccion_ventanas, _episodios y
%  _huecos (esta ultima solo si make_fig3 = true), en .eps (vectorial) y
%  .png (300 dpi).
%  =========================================================================

clear; clc; close all;

%% ===================== CONFIGURACION =====================
scriptPath = 'D:\Documentos\02 MROI\07 Tesis\03 Extension Tesis\CGM_Project\CGM_Project\matlab';  % <<< tu raiz

res_tag   = '_synth_s5p6_exc';        % corrida final (fallas manuales por paciente)
patients  = {'540', '559', '596'};
imp_names = {'gru', '1dcnn'};         % imputador de cada configuracion (detector = GRU)
Ts_min    = 5;

ctx_episode     = 18;                 % muestras de contexto a cada lado de un episodio inyectado (1.5 h)
ctx_gap         = 24;                 % muestras de contexto alrededor de un hueco real (2 h)
min_gap_samples = 20;                 % huecos reales mas cortos no se dibujan en la Figura 3

xlab_time = 'Tiempo (horas)';         % etiqueta del eje X (mismo estilo que la figura de 4.4);
                                      % el pie de figura aclara: desde el inicio de la ventana
legend_fs = 9;                        % tamano de letra de la leyenda (prueba 10 u 11 si hace falta)
letters   = 'abcdef';                 % etiqueta bajo el eje X de cada panel

show_col_titles = true;               % Figura 2: 'Paciente NNN' como titulo de cada columna

make_fig1 = true;
make_fig2 = true;
make_fig3 = false;                    % huecos reales (opcional)

% Colores (mismo criterio que la figura de 4.4)
col_ref   = [0 0 0];
col_raw   = [0.55 0.55 0.55];
col_gru   = [0.91 0.45 0.05];
col_cnn   = [0.48 0.18 0.62];
col_disc  = [1.00 0.85 0.85];
col_noise = [1.00 0.95 0.75];
col_gap   = [0.88 0.88 0.88];

res_dir = fullfile(scriptPath, 'data', 'ohio', 'results');
fig_dir = fullfile(scriptPath, 'figures', 'ohio');
if ~exist(fig_dir, 'dir'), mkdir(fig_dir); end

arrow = char(8594);
lab_disc = ['Desconexi' char(243) 'n inyectada'];
lab_gru = ['GRU ' arrow ' GRU'];
lab_cnn = ['GRU ' arrow ' 1D-CNN'];

%% ===================== CARGA =====================
nP = numel(patients);
P  = struct('pid', cell(1, nP), 'raw_full', [], 'raw', [], 'ref', [], 'ft', [], ...
            'gru', [], 'cnn', [], 'gru_imp', [], 'cnn_imp', [], 'inj', []);

for p = 1:nP
    pid = patients{p};
    out = cell(1, 2);
    for c = 1:2
        f = fullfile(res_dir, sprintf('results_ohio_%s_gru_det_%s_imp%s_latest.mat', ...
            pid, imp_names{c}, res_tag));
        if ~exist(f, 'file')
            error('plot_ohio_reconstruccion_coopt: no existe %s', f);
        end
        S = load(f, 'g_test', 'g_test_real', 'g_final_all', 'fault_type', 'inj_all');
        out{c} = mean(S.g_final_all, 1)';                 % media de las 5 redes
        if c == 1
            P(p).raw_full = S.g_test(:);                  % lectura con fallos (ceros incluidos)
            P(p).ref      = S.g_test_real(:);             % lectura original (NaN en huecos reales)
            P(p).ft       = double(S.fault_type(:));      % 0 limpio, 1 hueco, 2 ruido, 3 desconexion
            ia = S.inj_all;                               % el pipeline lo guarda como celda (una por colocacion)
            if iscell(ia), P(p).inj = ia{1}; else, P(p).inj = ia(1); end
        end
    end
    P(p).pid     = pid;
    P(p).gru     = out{1};
    P(p).cnn     = out{2};
    P(p).raw     = P(p).raw_full;
    P(p).raw(P(p).raw < 10) = NaN;                        % enmascara ceros de desconexion y huecos
    P(p).gru_imp = imputed_only(P(p).raw_full, P(p).gru);
    P(p).cnn_imp = imputed_only(P(p).raw_full, P(p).cnn);
end
T = numel(P(1).ref);
t = (0:T-1)' * Ts_min / 60;                               % horas desde el inicio de la ventana
dt = Ts_min / 60;

%% ===================== FIGURA 1: VENTANAS COMPLETAS =====================
if make_fig1
    fig = figure('Color', 'w', 'Position', [100 100 1100 860]);
    tl = tiledlayout(3, 1, 'TileSpacing', 'compact', 'Padding', 'compact');
    for p = 1:nP
        ax = nexttile;
        yl = y_limits(P(p), 1:T);
        draw_panel(ax, t, dt, P(p), [0 t(end)], yl, col_ref, col_raw, col_gru, col_cnn, ...
                   col_disc, col_noise, col_gap);
        ylabel(ax, 'Glucosa (mg/dL)');
        panel_xlabel(ax, letters(p), p == nP, xlab_time);
        if p == 1, ax1 = ax; end
    end
    add_legend(ax1, col_ref, col_raw, col_gru, col_cnn, col_disc, col_noise, col_gap, ...
               lab_gru, lab_cnn, lab_disc, true(1, 7), legend_fs);
    save_fig(fig, fig_dir, 'fig_ohio_reconstruccion_ventanas');
end

%% ===================== FIGURA 2: EPISODIOS INYECTADOS (2 filas x 3 columnas) =====================
% Fila 1: desconexion mas larga (tipo 3). Fila 2: rafaga de ruido mas larga (tipo 2).
if make_fig2
    fig = figure('Color', 'w', 'Position', [100 100 1300 780]);
    tl = tiledlayout(2, nP, 'TileSpacing', 'compact', 'Padding', 'compact');
    ep_type  = [3 2];
    ep_label = {'desconexion', 'ruido'};
    k = 0;
    for r = 1:2
        for p = 1:nP
            k  = k + 1;
            ax = nexttile;
            [lo, hi, a, b] = episode_range(P(p).inj, ep_type(r), ctx_episode, T);
            yl = y_limits(P(p), lo:hi);
            draw_panel(ax, t, dt, P(p), [t(lo) t(hi)], yl, col_ref, col_raw, col_gru, col_cnn, ...
                       col_disc, col_noise, col_gap);
            panel_xlabel(ax, letters(k), r == 2, xlab_time);
            if p == 1, ylabel(ax, 'Glucosa (mg/dL)'); end
            if r == 1 && show_col_titles
                title(ax, ['Paciente ' P(p).pid], 'FontSize', 11, 'FontWeight', 'bold');
            end
            if k == 1, ax1 = ax; end
            fprintf('Fig 2 (%s) | paciente %s | %s de %d muestras (%.1f h), muestras %d-%d\n', ...
                letters(k), P(p).pid, ep_label{r}, b - a + 1, (b - a + 1) * dt, a, b);
        end
    end
    add_legend(ax1, col_ref, col_raw, col_gru, col_cnn, col_disc, col_noise, col_gap, ...
               lab_gru, lab_cnn, lab_disc, logical([1 1 1 1 1 1 0]), legend_fs);
    save_fig(fig, fig_dir, 'fig_ohio_reconstruccion_episodios');
end

%% ===================== FIGURA 3: HUECOS REALES LARGOS =====================
if make_fig3
    gaps = zeros(0, 3);                                    % [paciente, inicio, fin]
    for p = 1:nP
        r = runs_of(P(p).ft == 1);
        for k = 1:size(r, 1)
            if r(k, 2) - r(k, 1) + 1 >= min_gap_samples
                gaps(end + 1, :) = [p r(k, 1) r(k, 2)]; %#ok<SAGROW>
            end
        end
    end
    if isempty(gaps)
        fprintf('Fig 3 | no hay huecos reales de %d muestras o mas; se omite.\n', min_gap_samples);
    else
        nG = size(gaps, 1);
        fig = figure('Color', 'w', 'Position', [100 100 560 * nG + 120 430]);
        tl = tiledlayout(1, nG, 'TileSpacing', 'compact', 'Padding', 'compact');
        for k = 1:nG
            p  = gaps(k, 1);
            ax = nexttile;
            lo = max(gaps(k, 2) - ctx_gap, 1);
            hi = min(gaps(k, 3) + ctx_gap, T);
            yl = y_limits(P(p), lo:hi);
            draw_panel(ax, t, dt, P(p), [t(lo) t(hi)], yl, col_ref, col_raw, col_gru, col_cnn, ...
                       col_disc, col_noise, col_gap);
            panel_xlabel(ax, letters(k), true, xlab_time);
            if k == 1, ylabel(ax, 'Glucosa (mg/dL)'); ax1 = ax; end
            fprintf('Fig 3 (%s) | paciente %s | hueco real de %d muestras (%.1f h), muestras %d-%d\n', ...
                letters(k), P(p).pid, gaps(k, 3) - gaps(k, 2) + 1, (gaps(k, 3) - gaps(k, 2) + 1) * dt, ...
                gaps(k, 2), gaps(k, 3));
        end
        add_legend(ax1, col_ref, col_raw, col_gru, col_cnn, col_disc, col_noise, col_gap, ...
                   lab_gru, lab_cnn, lab_disc, logical([1 0 1 1 0 0 1]), legend_fs);
        save_fig(fig, fig_dir, 'fig_ohio_reconstruccion_huecos');
    end
end

fprintf('\nListo. Figuras en %s\n', fig_dir);

%% ===================== FUNCIONES LOCALES =====================
function y = imputed_only(raw_full, out)
%IMPUTED_ONLY Salida solo donde difiere de la lectura (con una muestra de
%   margen a cada lado para que las lineas se conecten con la senal).
    m  = abs(out - raw_full) > 1e-6;
    me = m;
    me(2:end)   = me(2:end)   | m(1:end-1);
    me(1:end-1) = me(1:end-1) | m(2:end);
    y = nan(size(out));
    y(me) = out(me);
end

function r = runs_of(mask)
%RUNS_OF Tramos consecutivos de una mascara logica: filas [inicio fin].
    mask = mask(:)';
    d = diff([0 double(mask) 0]);
    r = [find(d == 1)', find(d == -1)' - 1];
end

function yl = y_limits(Pp, idx)
%Y_LIMITS Limites verticales segun lo que se dibuja en el tramo idx.
    v = [Pp.ref(idx); Pp.raw(idx); Pp.gru_imp(idx); Pp.cnn_imp(idx)];
    v = v(~isnan(v));
    yl = [max(0, floor((min(v) - 10) / 10) * 10), ceil((max(v) + 15) / 10) * 10];
end

function draw_panel(ax, t, dt, Pp, xl, yl, col_ref, col_raw, col_gru, col_cnn, col_disc, col_noise, col_gap)
%DRAW_PANEL Un panel: sombreado de episodios y las cuatro curvas.
    hold(ax, 'on');
    set(ax, 'XLim', xl, 'YLim', yl, 'Box', 'on', 'FontSize', 10);
    grid(ax, 'on');
    shade_runs(ax, t, dt, Pp.ft == 1, col_gap,   yl);
    shade_runs(ax, t, dt, Pp.ft == 2, col_noise, yl);
    shade_runs(ax, t, dt, Pp.ft == 3, col_disc,  yl);
    plot(ax, t, Pp.raw,     '--', 'Color', col_raw, 'LineWidth', 0.9);
    plot(ax, t, Pp.ref,     '-',  'Color', col_ref, 'LineWidth', 1.3);
    plot(ax, t, Pp.gru_imp, '-',  'Color', col_gru, 'LineWidth', 1.7);
    plot(ax, t, Pp.cnn_imp, '--', 'Color', col_cnn, 'LineWidth', 1.7);
    set(ax, 'Layer', 'top');
end

function shade_runs(ax, t, dt, mask, col, yl)
%SHADE_RUNS Sombrea cada tramo consecutivo de la mascara.
    r = runs_of(mask);
    for k = 1:size(r, 1)
        x0 = t(r(k, 1)) - dt / 2;
        x1 = t(r(k, 2)) + dt / 2;
        patch('Parent', ax, 'XData', [x0 x1 x1 x0], 'YData', [yl(1) yl(1) yl(2) yl(2)], ...
              'FaceColor', col, 'EdgeColor', 'none', 'HandleVisibility', 'off');
    end
end

function [lo, hi, a, b] = episode_range(inj, type_code, ctx, T)
%EPISODE_RANGE Tramo a dibujar alrededor del episodio mas largo de un tipo
%   (2 ruido, 3 desconexion): [lo hi] con contexto, y [a b] del episodio.
    st = inj.start(:);  sp = inj.stop(:);  ty = inj.type(:);
    len = sp - st + 1;  len(ty ~= type_code) = -1;
    [~, i] = max(len);
    a  = st(i);  b = sp(i);
    lo = max(a - ctx, 1);
    hi = min(b + ctx, T);
end

function panel_xlabel(ax, letter, with_time, time_text)
%PANEL_XLABEL Etiqueta del eje X: el tiempo (opcional) y debajo la letra del
%   panel en negritas entre parentesis. \bf solo afecta a la segunda linea.
    if with_time
        xlabel(ax, {time_text; ['\bf(' letter ')']});
    else
        xlabel(ax, ['\bf(' letter ')']);
    end
end

function add_legend(ax, col_ref, col_raw, col_gru, col_cnn, col_disc, col_noise, col_gap, lab_gru, lab_cnn, lab_disc, keep, fs)
%ADD_LEGEND Leyenda comun en la parte superior, solo con las entradas de keep.
    h(1) = plot(ax, NaN, NaN, '-',  'Color', col_ref, 'LineWidth', 1.3);
    h(2) = plot(ax, NaN, NaN, '--', 'Color', col_raw, 'LineWidth', 0.9);
    h(3) = plot(ax, NaN, NaN, '-',  'Color', col_gru, 'LineWidth', 1.7);
    h(4) = plot(ax, NaN, NaN, '--', 'Color', col_cnn, 'LineWidth', 1.7);
    h(5) = patch('Parent', ax, 'XData', NaN, 'YData', NaN, 'FaceColor', col_disc,  'EdgeColor', 'none');
    h(6) = patch('Parent', ax, 'XData', NaN, 'YData', NaN, 'FaceColor', col_noise, 'EdgeColor', 'none');
    h(7) = patch('Parent', ax, 'XData', NaN, 'YData', NaN, 'FaceColor', col_gap,   'EdgeColor', 'none');
    labels = {'Referencia', 'Lectura con fallo', lab_gru, lab_cnn, ...
              lab_disc, 'Ruido blanco inyectado', 'Hueco real'};
    n  = nnz(keep);
    nc = n;  if n > 4, nc = ceil(n / 2); end
    lg = legend(ax, h(keep), labels(keep), 'Orientation', 'horizontal', 'NumColumns', nc, 'Box', 'off');
    lg.FontSize = fs;
    lg.Layout.Tile = 'north';
end

function save_fig(fig, fig_dir, name)
%SAVE_FIG Exporta en EPS vectorial y PNG de 300 dpi.
    exportgraphics(fig, fullfile(fig_dir, [name '.eps']), 'ContentType', 'vector');
    exportgraphics(fig, fullfile(fig_dir, [name '.png']), 'Resolution', 300);
    fprintf('Guardado: %s (.eps/.png)\n', fullfile(fig_dir, name));
end